# RANI — konfigurasi deployment Docker Hub (pull & run)
#
#   cp .env.hub.example .env
#   # isi semua nilai di bawah, lalu:
#   docker compose -f docker-compose.hub.yml up -d
#
# JANGAN commit file .env (sudah ada di .gitignore).

# --- Image ---
# Tag yang dipakai; ganti ke versi tertentu (mis. 0.1.0) untuk produksi.
RANI_IMAGE=adhityatp/raniassets:v0.1.0
# Nama project compose = prefix container & volume. Ganti kalau di server sudah
# ada stack RANI lain (mis. rani-dev) supaya volume tidak tertukar.
COMPOSE_PROJECT_NAME=rani

# --- Port & waktu ---
RANI_HTTP_PORT=8091
TZ=Asia/Jakarta

# --- Database (dipakai juga oleh service postgres) ---
POSTGRES_DB=rani
POSTGRES_USER=rani
# WAJIB diisi. Gunakan karakter aman URL (huruf/angka) atau URL-encode.
POSTGRES_PASSWORD=ubah-password-db-ini

# --- Login UI ---------------------------------------------------------------
# Admin di-seed saat boot pertama. Ganti password setelah login pertama.
RANI_ADMIN_USER=admin
RANI_ADMIN_PASSWORD=ubah-password-admin-ini

# --- Keamanan ingest --------------------------------------------------------
# Pepper untuk enkripsi secret agent & community SNMP. GANTI dengan random
# 64 hex (openssl rand -hex 32). Mengubah pepper = agent lama & community
# tersimpan tidak bisa didekripsi.
RANI_INGEST_PEPPER=ganti-dengan-random-64-hex

# Password role DB read-only untuk menu Reports. Random 32 hex
# (openssl rand -hex 16). Kosong = menu Reports menolak eksekusi.
RANI_REPORT_DB_PASSWORD=ganti-dengan-random-32-hex

# --- Agent & scan -----------------------------------------------------------
# 1 = agent boleh push tanpa token (default). 0 = wajib enroll+HMAC.
RANI_TOKENLESS_PUSH=1
# Interval push default yang dikirim server ke agent (detik).
RANI_DEFAULT_INTERVAL_S=3600
# Toleransi skew timestamp HMAC (detik).
RANI_TS_SKEW_S=300
# Agent dianggap offline setelah (detik) tanpa push.
RANI_OFFLINE_AFTER_S=10800
# Batas scan SNMP.
RANI_SCAN_MAX_HOSTS=512
RANI_SCAN_CONCURRENCY=16
RANI_SCAN_TIMEOUT_S=1.0
RANI_SCAN_RETRIES=1
# Port map L2 (bridge FDB): MAC ↔ port switch. 0 = matikan global.
RANI_SCAN_FDB_ENABLED=1
RANI_SCAN_FDB_MAX=2000
RANI_SCAN_FDB_UPLINK_MACS=10
# Umur sesi login (jam).
RANI_SESSION_TTL_H=12
# Login lokal / AD (DOMAIN\user atau UPN). ON untuk AD bila ada connector.
RANI_AUTH_LOCAL_ENABLED=1
RANI_AD_ENABLED=0
# Interval default sync connector baru (detik; 0 = hanya manual).
RANI_AD_SYNC_INTERVAL_S=3600
# Panjang minimum password lokal.
RANI_PASSWORD_MIN_LEN=12
# Percobaan login per IP dan per principal per 5 menit.
RANI_LOGIN_MAX_ATTEMPTS=20
# Bind password AD diisi lewat UI (terenkripsi Fernet di DB), bukan di file ini.
# Batas report SQL.
RANI_REPORT_MAX_ROWS=1000
RANI_REPORT_TIMEOUT_MS=8000

# --- Lain-lain --------------------------------------------------------------
RANI_ENV=production
RANI_LOG_LEVEL=info