# RANI ProjectDev — copy ke .env lalu isi password.
# DB
POSTGRES_DB=rani
POSTGRES_USER=rani
POSTGRES_PASSWORD=ubah-password-db-ini
# Server
RANI_HTTP_PORT=8091
TZ=Asia/Jakarta
# Auth UI (password admin di-seed saat boot; ganti setelah login pertama)
RANI_ADMIN_USER=admin
RANI_ADMIN_PASSWORD=ubah-password-admin-ini
# Secret untuk hash agent secret (HMAC pepper). Ganti dengan random 64 hex.
RANI_INGEST_PEPPER=ganti-dengan-random-64-hex
# Interval push default (detik) yang dikirim balik ke agent
RANI_DEFAULT_INTERVAL_S=3600
# Batas waktu (detik) toleransi skew timestamp HMAC
RANI_TS_SKEW_S=300
# Opsional: image registry lokal untuk migrasi server
# RANI_IMAGE=192.168.88.92:5000/rani-server:latest
# Push tanpa token/HMAC (agent 0.2+, dikenali dari machine_id). 0 = wajib enroll+HMAC.
RANI_TOKENLESS_PUSH=1

# Password role DB read-only untuk custom report SQL (/reports). Random 32 hex.
RANI_REPORT_DB_PASSWORD=ganti-dengan-random-32-hex

# Scan SNMP + port map L2 (MAC ↔ port switch dari bridge FDB).
# FDB_ENABLED=0 mematikan port map untuk semua grup (masih bisa per grup di UI).
RANI_SCAN_MAX_HOSTS=512
RANI_SCAN_CONCURRENCY=16
RANI_SCAN_TIMEOUT_S=1.0
RANI_SCAN_FDB_ENABLED=1
RANI_SCAN_FDB_MAX=2000
RANI_SCAN_FDB_UPLINK_MACS=10

# --- Users & akses (F5, aktif) ---
# Umur sesi login (jam).
RANI_SESSION_TTL_H=12
# Login lokal (username polos) dan login AD (DOMAIN\user / UPN).
RANI_AUTH_LOCAL_ENABLED=1
RANI_AD_ENABLED=0
# Interval default sync connector baru (detik; 0 = hanya manual).
RANI_AD_SYNC_INTERVAL_S=3600
# Panjang minimum password lokal.
RANI_PASSWORD_MIN_LEN=12
# Percobaan login per IP dan per principal per 5 menit.
RANI_LOGIN_MAX_ATTEMPTS=20
# Folder skrip Actions (dijalankan di PC pengguna via raniaction://).
# Di hub image sudah terisi contoh; override dengan bind mount ./actions.
RANI_ACTIONS_DIR=/srv/actions
RANI_ACTIONS_URLTTL_S=300
# Bind password AD diisi lewat UI (terenkripsi Fernet di DB), bukan di file ini.
