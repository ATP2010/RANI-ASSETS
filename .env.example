# =============================================================================
# RANI — konfigurasi environment
# =============================================================================
# QUICK START
#   dev  : cp .env.example .env  ->  isi password  ->  docker compose up -d --build
#          UI: http://<ip-server>:8091   (login RANI_ADMIN_USER / RANI_ADMIN_PASSWORD)
#   prod : sudo bash scripts/install-ubuntu.sh   (HTTPS otomatis via Caddy)
#          UI: https://<RANI_DOMAIN>
#   upgrade: docker compose -f docker-compose.hub.yml -f docker-compose.caddy.yml pull
#            docker compose -f docker-compose.hub.yml -f docker-compose.caddy.yml up -d
#           (migrasi DB jalan otomatis di entrypoint api)
#
# Catatan:
#  - Baris yang diawali '#' adalah komentar, diabaikan docker compose.
#  - Jangan commit file .env (sudah di-.gitignore). Salin dari .env.example.
#  - Generate secret acak:  openssl rand -hex 32
# =============================================================================

# ---- Database (PostgreSQL 16) ----
POSTGRES_DB=rani
POSTGRES_USER=rani
POSTGRES_PASSWORD=ubah-password-db-ini          # WAJIB ganti (min 16 karakter)

# ---- Server ----
RANI_HTTP_PORT=8091                              # port host -> container 8000 (dev)
# Produksi dengan Caddy: batasi ke localhost agar hanya Caddy yang expose 80/443:
# RANI_HTTP_PORT=127.0.0.1:8091
TZ=Asia/Jakarta

# ---- Auth UI (akun admin di-seed saat boot pertama) ----
RANI_ADMIN_USER=admin
RANI_ADMIN_PASSWORD=ubah-password-admin-ini      # WAJIB ganti setelah login pertama
RANI_INGEST_PEPPER=ganti-dengan-random-64-hex    # HMAC pepper; generate: openssl rand -hex 32

# ---- Agent / push ----
RANI_DEFAULT_INTERVAL_S=3600
RANI_TS_SKEW_S=300
RANI_OFFLINE_AFTER_S=10800   # agent dianggap offline setelah (detik) tanpa push
RANI_TOKENLESS_PUSH=1                            # 0 = wajib enroll+HMAC per push

# ---- Custom report SQL (role read-only rani_report) ----
RANI_REPORT_DB_PASSWORD=ganti-dengan-random-32-hex   # generate: openssl rand -hex 16
RANI_REPORT_MAX_ROWS=1000
RANI_REPORT_TIMEOUT_MS=8000

# ---- Scan SNMP + port map L2 (MAC <-> port switch dari bridge FDB) ----
RANI_SCAN_MAX_HOSTS=512
RANI_SCAN_CONCURRENCY=16
RANI_SCAN_TIMEOUT_S=1.0
RANI_SCAN_RETRIES=1
RANI_SCAN_FDB_ENABLED=1
RANI_SCAN_FDB_MAX=2000
RANI_SCAN_FDB_UPLINK_MACS=10

# ---- Users & akses (F5) ----
RANI_SESSION_TTL_H=12
RANI_AUTH_LOCAL_ENABLED=1                        # login lokal username polos
RANI_AD_ENABLED=0                                # 1 = aktifkan login Active Directory (DOMAIN\user / UPN)
RANI_AD_SYNC_INTERVAL_S=3600                     # interval default sync connector baru (0 = manual)
RANI_PASSWORD_MIN_LEN=12
RANI_LOGIN_MAX_ATTEMPTS=20                        # per IP & per principal per 5 menit

# ---- Jadwal scan otomatis (menu Agents → Groups) ----
# RANI_SCAN_SCHEDULER_TICK_S=30
# RANI_SCAN_SCHEDULE_MIN_INTERVAL_MIN=5
# RANI_SCHEDULE_TZ=Asia/Jakarta

# ---- Actions (skrip dijalankan di PC pengguna via raniaction://) ----
RANI_ACTIONS_DIR=/srv/actions
RANI_ACTIONS_URLTTL_S=300

# ---- Caddy / HTTPS (opsional, untuk deploy dengan docker-compose.caddy.yml) ----
# Prasyarat: DNS A/AAAA RANI_DOMAIN -> IP server; port 80 & 443 terbuka.
#   sudo ufw allow 80/tcp && sudo ufw allow 443/tcp
# Jalankan: docker compose -f docker-compose.hub.yml -f docker-compose.caddy.yml up -d
# Atau satu perintah: sudo bash scripts/install-ubuntu.sh
RANI_DOMAIN=rani.example.com                     # ganti dengan domain Anda
RANI_ACME_EMAIL=admin@example.com                # email Let's Encrypt (notifikasi expiry)

# ---- Opsional: image registry lokal untuk migrasi server ----
# RANI_IMAGE=192.168.88.92:5000/rani-server:latest
