{
  "manifest_version": 3,
  "name": "RANI Actions",
  "version": "1.0.0",
  "description": "Menjalankan aksi cepat RANI (RDP, SSH, skrip, dll.) dari halaman web RANI — meniru Lansweeper Shell Execute.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "RANI Actions",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "102",
  "key": ""
}
