# =============================================================================
# RANI — environment variables untuk stack Portainer
# =============================================================================
# Cara pakai:
#   1) Portainer → Stacks → Add stack → Name: rani → Build method: Web editor
#   2) Paste isi Portainer/docker-compose.yml
#   3) Environment variables → "Load variables from .env file" → upload file ini
#   4) Isi 2 nilai saja: POSTGRES_PASSWORD dan RANI_ADMIN_PASSWORD
#   5) Deploy the stack
#
# Akses awal (tanpa domain):
#   http://<ip-server>/        → lewat Caddy (port 80)
#   http://<ip-server>:8091/   → langsung ke API (default hanya dari server sendiri)
#
# Nanti kalau domain sudah siap: isi RANI_DOMAIN + RANI_ACME_EMAIL lalu
# "Update the stack" — HTTPS diaktifkan otomatis, tanpa mengubah compose.
#
# File contoh ini aman (tanpa secret). Jangan commit file yang sudah diisi.
# =============================================================================

# --- WAJIB: isi 2 nilai di bawah ---
POSTGRES_DB=rani
POSTGRES_USER=rani
# Huruf/angka saja agar aman di DATABASE_URL (contoh: openssl rand -hex 16).
POSTGRES_PASSWORD=

RANI_ADMIN_USER=admin
# Password login admin pertama. Kosong = password acak dibuat dan dicetak di log api.
RANI_ADMIN_PASSWORD=

# --- OPSIONAL: domain & HTTPS (biarkan kosong untuk akses via IP) ---
# Kosong = Caddy melayani HTTP di port 80. Isi hostname (tanpa http://) untuk
# mengaktifkan HTTPS otomatis lewat Let's Encrypt.
# RANI_DOMAIN=rani.example.com
# RANI_ACME_EMAIL=admin@example.com

# --- OPSIONAL: secret (kosong = otomatis, tidak perlu diisi) ---
# RANI_INGEST_PEPPER=          # diturunkan otomatis dari POSTGRES_PASSWORD
# RANI_REPORT_DB_PASSWORD=     # diturunkan otomatis; menu Reports langsung aktif

# --- OPSIONAL: port & zona waktu ---
# RANI_BIND_IP=127.0.0.1
# RANI_HTTP_PORT=8091
# TZ=Asia/Jakarta

# --- OPSIONAL: agent / push ---
# RANI_TOKENLESS_PUSH=1
# RANI_DEFAULT_INTERVAL_S=3600
# RANI_TS_SKEW_S=300
# RANI_OFFLINE_AFTER_S=10800
# RANI_RATE_LIMIT_PER_MIN=30

# --- OPSIONAL: users & akses ---
# RANI_SESSION_TTL_H=12
# RANI_AUTH_LOCAL_ENABLED=1
# RANI_AD_ENABLED=0
# RANI_AD_SYNC_INTERVAL_S=3600
# RANI_PASSWORD_MIN_LEN=12
# RANI_LOGIN_MAX_ATTEMPTS=20

# --- OPSIONAL: reports ---
# RANI_REPORT_DB_USER=rani_report
# RANI_REPORT_MAX_ROWS=1000
# RANI_REPORT_TIMEOUT_MS=8000

# --- OPSIONAL: scan SNMP + port map L2 ---
# RANI_SCAN_MAX_HOSTS=512
# RANI_SCAN_CONCURRENCY=16
# RANI_SCAN_TIMEOUT_S=1.0
# RANI_SCAN_RETRIES=1
# RANI_SCAN_FDB_ENABLED=1
# RANI_SCAN_FDB_MAX=2000
# RANI_SCAN_FDB_UPLINK_MACS=10

# --- OPSIONAL: actions ---
# RANI_ACTIONS_DIR=/srv/actions
# RANI_ACTIONS_URLTTL_S=300

# --- OPSIONAL: image & log ---
# RANI_IMAGE=adhityatp/raniassets:latest
# RANI_ENV=production
# RANI_LOG_LEVEL=info

# --- Jadwal scan otomatis (menu Agents → Groups) ---
# RANI_SCAN_SCHEDULER_TICK_S=30
# RANI_SCAN_SCHEDULE_MIN_INTERVAL_MIN=5
# RANI_SCHEDULE_TZ=Asia/Jakarta
